/* 全局样式 —— 扁平化配色（对齐 UI 稿 V3.5 / 技术设计 v2.1）
   适老化：正文 16px 起步、次要 13px、命中区 ≥44px、高对比 */
page {
  --brand: #4a8b6f;          /* 松绿主色 */
  --brand-dark: #3a715a;
  --ink: #1f2328;            /* 主文字，对比度 > 7:1 */
  --ink2: #5f6368;           /* 次要文字，约 6:1 */
  --line: #e3e8e4;
  --bg: #f6f7f9;
  --card: #ffffff;
  --danger: #c0392b;
  --radius: 14rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 32rpx;          /* 16px */
  color: var(--ink);
  background: var(--bg);
  box-sizing: border-box;
}

view, text, input, button {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
}

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.h1 {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}

.h2 {
  font-size: 30rpx;
  color: var(--ink2);
  line-height: 1.6;
  margin-top: 12rpx;
}

.sec-t {
  font-size: 28rpx;
  color: var(--ink2);
  margin: 32rpx 0 16rpx;
  display: flex;
  align-items: center;
}

.primary-btn {
  min-height: 96rpx;         /* 命中区 ≥48px */
  line-height: 96rpx;
  text-align: center;
  background: var(--brand);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: var(--radius);
  margin-top: 24rpx;
}
.primary-btn:active { background: var(--brand-dark); }

.ghost-btn {
  min-height: 96rpx;
  line-height: 94rpx;
  text-align: center;
  background: #fff;
  color: var(--brand);
  font-size: 34rpx;
  font-weight: 600;
  border: 2rpx solid var(--brand);
  border-radius: var(--radius);
  margin-top: 20rpx;
}
.ghost-btn:active { background: #f0f6f3; }

.field {
  margin-top: 24rpx;
}
.field-label {
  font-size: 28rpx;
  color: var(--ink2);
  margin-bottom: 12rpx;
  display: block;
}
.field-input {
  min-height: 96rpx;
  padding: 0 24rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
  font-size: 34rpx;
  color: var(--ink);
}

.warn-box {
  background: #fdf6ec;
  border: 1rpx solid #f0d9b5;
  color: #8a6d3b;
  font-size: 26rpx;
  line-height: 1.6;
  padding: 20rpx 24rpx;
  border-radius: var(--radius);
  margin-top: 20rpx;
}

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
