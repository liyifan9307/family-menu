.home-page { padding:36rpx 40rpx 44rpx; }
.family-title { font-size:42rpx; font-weight:500; color:var(--ink); line-height:1.4; min-height:80rpx; display:flex; align-items:center; overflow-wrap:break-word; }
.greeting { font-size:32rpx; color:var(--ink2); margin-top:4rpx; line-height:1.6; }
.section-label { display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:12rpx; font-size:32rpx; font-weight:500; margin:52rpx 0 24rpx; }
.section-caption { font-size:24rpx; color:var(--ink2); font-weight:400; }
.home-page button { box-sizing:border-box; width:100%; margin:0; font-weight:400; text-align:left; line-height:1.5; }
.home-page button::after { border:0; }
.home-page button.schedule-entry { padding:32rpx; background:#fff; border:1rpx solid var(--line); border-radius:24rpx; color:var(--ink); box-shadow:0 6rpx 24rpx rgba(38,62,50,.05); }
.schedule-top { display:flex; justify-content:space-between; align-items:center; gap:12rpx; }
.feature-tag { font-size:22rpx; color:var(--brand); padding:4rpx 18rpx; border:1rpx solid var(--brand); border-radius:32rpx; }
.schedule-count { color:var(--ink2); font-size:24rpx; }
.schedule-next { display:flex; align-items:baseline; gap:16rpx; margin-top:24rpx; flex-wrap:wrap; }
.schedule-time { font-size:48rpx; font-weight:600; font-variant-numeric:tabular-nums; }
.schedule-title { font-size:32rpx; flex:1; min-width:160rpx; overflow-wrap:break-word; }
.schedule-place { font-size:32rpx; color:var(--ink2); margin-top:12rpx; overflow-wrap:break-word; }
.schedule-empty { font-size:32rpx; margin-top:24rpx; color:var(--ink2); }
.schedule-foot { display:flex; justify-content:space-between; font-size:26rpx; color:var(--brand); margin-top:28rpx; padding-top:24rpx; border-top:1rpx solid var(--line); }
.home-page button.feature { background:#eaf0e6; border-radius:24rpx; padding:32rpx; margin-top:28rpx; color:var(--ink); }
.feature-title { font-size:44rpx; font-weight:500; }
.feature-description { font-size:26rpx; color:var(--ink2); margin-top:8rpx; }
.more { text-align:center; color:var(--ink2); font-size:24rpx; margin-top:32rpx; }
.state,.load-error { text-align:center; color:var(--ink2); padding-top:120rpx; line-height:1.7; }
@media(max-width:340px){.home-page{padding-left:32rpx;padding-right:32rpx}.home-page button.schedule-entry{padding:32rpx}}
