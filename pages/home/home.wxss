.home { padding-top: 24rpx; }

.center-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}
.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid var(--line);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 32rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }

.fam-bar {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  margin-bottom: 20rpx;
}
.fam-dot { width: 24rpx; height: 24rpx; border-radius: 50%; margin-right: 16rpx; }
.fam-name { font-size: 36rpx; font-weight: 600; color: var(--ink); }
.fam-role {
  font-size: 24rpx; color: var(--brand); background: #eef5f1;
  padding: 6rpx 16rpx; border-radius: 20rpx; margin-left: 16rpx;
}
.fam-arrow { margin-left: auto; font-size: 28rpx; color: var(--ink2); }

.switcher {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 12rpx;
  margin-bottom: 24rpx;
}
.switch-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
}
.switch-item.active { background: #eef5f1; }
.sw-dot { width: 20rpx; height: 20rpx; border-radius: 50%; margin-right: 16rpx; }
.sw-name { font-size: 32rpx; color: var(--ink); }
.sw-role { font-size: 24rpx; color: var(--ink2); margin-left: 16rpx; }
.sw-check { margin-left: auto; color: var(--brand); font-size: 32rpx; }
.switch-tip { font-size: 24rpx; color: var(--ink2); padding: 16rpx 20rpx 8rpx; }

.invite-card { padding: 32rpx; }
.card-h { margin-bottom: 24rpx; }
.card-t { font-size: 34rpx; font-weight: 600; color: var(--ink); }
.card-sub { font-size: 26rpx; color: var(--ink2); margin-top: 8rpx; }
.code-row { display: flex; align-items: center; }
.code-box {
  flex: 1;
  min-height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: #f4f8f6;
  border: 2rpx dashed var(--brand);
  border-radius: var(--radius);
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 10rpx;
  color: var(--brand);
}
.code-box.masked { color: var(--ink2); letter-spacing: 6rpx; }
.code-eye {
  min-width: 96rpx;
  min-height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--brand);
}
.code-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.mini-btn {
  flex: 1;
  min-height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 10rpx;
}
.mini-btn.ghost { background: #fff; color: var(--brand); border: 2rpx solid var(--brand); }

.member-card { padding: 8rpx 32rpx; }
.member-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  border-bottom: 1rpx solid var(--line);
}
.member-row:last-child { border-bottom: none; }
.m-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
/* V3.8 真头像 + V3.9 编辑资料：圆形裁剪 + 头像容器 */
.m-avatar-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}
.m-avatar-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eef1f4;
}
.m-cam {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: var(--brand);
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  border: 2rpx solid #fff;
}
.member-me { background: #f7faf8; }
.m-member-tip { font-size: 22rpx; color: var(--ink2); padding: 12rpx 8rpx 0; }
.m-info { margin-left: 20rpx; flex: 1; }
.m-name { font-size: 32rpx; color: var(--ink); font-weight: 500; }
.m-role { font-size: 24rpx; color: var(--ink2); margin-top: 6rpx; }
.m-remove {
  min-width: 96rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  color: var(--danger);
  font-size: 26rpx;
  border: 2rpx solid var(--danger);
  border-radius: 10rpx;
}

.placeholder {
  margin-top: 32rpx;
  background: var(--card);
  border: 2rpx dashed var(--line);
  border-radius: var(--radius);
  padding: 48rpx 32rpx;
  text-align: center;
}
.ph-icon { font-size: 64rpx; }
.ph-title { font-size: 34rpx; font-weight: 600; color: var(--ink2); margin-top: 16rpx; }
.ph-desc { font-size: 26rpx; color: var(--ink2); margin-top: 8rpx; }

.foot-note { margin-top: 32rpx; }

/* ——— V3.9 编辑我的资料浮层 ——— */
.pf-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(20, 28, 24, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.pf-sheet {
  width: 100%;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
}
.pf-title { font-size: 36rpx; font-weight: 600; color: var(--ink); }
.pf-sub { font-size: 24rpx; color: var(--ink2); margin-top: 8rpx; }
.pf-row { margin-top: 32rpx; }
.pf-label { font-size: 30rpx; font-weight: 500; color: var(--ink); margin-bottom: 16rpx; }
.pf-avatar-btn {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
}
.pf-avatar-btn::after { border: none; }
.pf-avatar-img { width: 112rpx; height: 112rpx; border-radius: 50%; background: #eef1f4; }
.pf-avatar-ph {
  width: 112rpx; height: 112rpx; border-radius: 50%;
  background: #eef5f1; color: var(--brand);
  font-size: 56rpx; line-height: 112rpx; text-align: center;
}
.pf-cam {
  position: absolute; right: -2rpx; bottom: -2rpx;
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: var(--brand); color: #fff;
  font-size: 22rpx; line-height: 36rpx; text-align: center;
  border: 2rpx solid #fff;
}
.pf-hint { font-size: 22rpx; color: var(--ink2); margin-top: 12rpx; }
.pf-input {
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  background: #f4f8f6;
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: var(--ink);
}
.pf-pholder { color: #9aa39d; font-size: 26rpx; }
.pf-actions { display: flex; gap: 24rpx; margin-top: 48rpx; }
.pf-btn {
  flex: 1; min-height: 92rpx; line-height: 92rpx; text-align: center;
  background: var(--brand); color: #fff; font-size: 32rpx; font-weight: 600;
  border-radius: 12rpx;
}
.pf-btn.ghost { background: #fff; color: var(--ink2); border: 2rpx solid var(--line); }

/* V3.10 解散家庭：危险操作区（仅 admin 可见） */
.danger-zone {
  margin-top: 40rpx;
  padding: 28rpx;
  background: #fff;
  border: 2rpx solid #f0d9d5;
  border-radius: var(--radius);
}
.dz-title { font-size: 28rpx; font-weight: 600; color: var(--danger); margin-bottom: 12rpx; }
.dz-desc { font-size: 24rpx; color: var(--ink2); line-height: 1.6; margin-bottom: 24rpx; }
.dz-btn {
  min-height: 88rpx; line-height: 88rpx; text-align: center;
  border: 2rpx solid var(--danger); color: var(--danger);
  background: #fff; font-size: 30rpx; font-weight: 600;
  border-radius: 12rpx;
}
.dz-btn.disabled {
  border-color: var(--line); color: #9aa39d; background: #f6f7f9; font-weight: 400;
}
