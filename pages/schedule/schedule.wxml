<view class="schedule-page">
  <view class="date-nav">
    <button data-days="-1" bindtap="changeDate" aria-label="前一天">‹</button>
    <text class="date-label">{{date}}</text>
    <button data-days="1" bindtap="changeDate" aria-label="后一天">›</button>
  </view>
  <view class="list-tools"><button class="text-button" bindtap="today">回到今天</button><button class="text-button" bindtap="subscribe">开启变更通知</button></view>
  <view wx:if="{{loading}}" class="state">正在加载安排…</view>
  <view wx:elif="{{error}}" class="state">{{error}}<button bindtap="reload">重新加载</button></view>
  <view wx:elif="{{!items.length}}" class="state"><view class="state-symbol">＋</view><view>这一天还没有安排</view><view class="hint">点右下角，为家人加一条</view></view>
  <view class="day-list">
    <view wx:for="{{items}}" wx:key="_id" class="schedule-card day-item {{item.status}}" data-id="{{item._id}}" bindtap="open">
      <view class="time-col"><view class="time-start">{{item.timeStart}}</view><view wx:if="{{item.timeEnd}}" class="time-end">{{item.timeEnd}}</view></view>
      <view class="item-main"><view class="item-heading"><view class="who-dot" style="background:{{item.ownerColor}}"></view><text class="item-title">{{item.title}}</text><text class="badge">{{item.statusLabel}}</text></view><view wx:if="{{item.place}}" class="place">{{item.place}}</view><view class="meta">{{item.childName ? item.childName + ' · ' : ''}}{{item.ownerName}}</view></view>
    </view>
  </view>
  <view class="bottom-actions"><button wx:if="{{!shareReady}}" class="ghost" bindtap="prepareShare" loading="{{sharing}}">分享给家人</button><button wx:else class="ghost" open-type="share">点击转发</button><button class="ghost" bindtap="image">转发图片</button><button class="primary fab" bindtap="add" aria-label="新增日程">＋</button></view>
 <view wx:if="{{detail}}" class="overlay" bindtap="close"><view class="sheet" catchtap="noop"><view class="sheet-handle"></view><view class="sheet-top"><text class="section">安排详情</text><button class="text-button" bindtap="close">关闭</button></view><view class="title">{{detail.title}}</view><view>{{detail.date}} {{detail.timeStart}}{{detail.timeEnd ? " — " + detail.timeEnd : ""}}</view><view>{{detail.place}}</view><view>{{detail.childName ? detail.childName + " · " : ""}}{{detail.ownerName}}</view><view class="badge">{{detail.statusLabel}}</view><view class="note">{{detail.note}}</view><button wx:if="{{permissions.edit}}" bindtap="edit">编辑安排</button><block wx:if="{{permissions.status}}"><button wx:if="{{detail.status === 'pending'}}" data-action="setStatus" data-status="done" bindtap="action" disabled="{{busy}}">标记已完成</button><button wx:if="{{detail.status === 'pending'}}" data-action="setStatus" data-status="cancelled" bindtap="action" disabled="{{busy}}">取消安排</button><button wx:else data-action="setStatus" data-status="pending" bindtap="action" disabled="{{busy}}">恢复待办</button></block><button wx:if="{{permissions.delete}}" class="danger" data-action="delete" bindtap="action" disabled="{{busy}}">删除安排</button><view class="section">变更记录</view><view wx:for="{{events}}" wx:key="_id" class="event">{{item.time}} · {{item.actorName}} · {{item.label}} {{item.toStatus}} {{item.reason}}</view><button wx:if="{{eventCursor}}" bindtap="moreEvents">更多记录</button></view></view>
</view>
