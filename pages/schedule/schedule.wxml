<view class="schedule-page">
  <view class="date-nav">
    <button data-days="-1" bindtap="changeDate" aria-label="前一天">‹</button>
    <text class="date-label">{{date}}</text>
    <button data-days="1" bindtap="changeDate" aria-label="后一天">›</button>
  </view>
  <view class="list-tools"><button class="text-button" bindtap="today">回到今天</button><button class="text-button" bindtap="subscribe">开启变更通知</button></view>
  <view wx:if="{{loading}}" class="state">正在加载安排…</view>
  <view wx:elif="{{error}}" class="state">{{error}}<button bindtap="reload">重新加载</button></view>
  <view wx:elif="{{!items.length}}" class="state"><view class="state-symbol">＋</view><view>这一天还没有安排</view><view class="hint">点右下角，为家人加一条</view></view>
  <view class="day-list">
    <view wx:for="{{items}}" wx:key="_id" class="schedule-card day-item {{item.status}}" data-id="{{item._id}}" bindtap="open">
      <view class="time-col"><view class="time-start">{{item.timeStart || '当天'}}</view><view wx:if="{{item.timeEnd}}" class="time-end">{{item.timeEnd}}</view></view>
      <view class="item-main"><view class="item-heading"><view class="who-dot" style="background:{{item.ownerColor}}"></view><text class="item-title">{{item.title}}</text><text class="badge">{{item.statusLabel}}</text></view><view wx:if="{{item.place}}" class="place">{{item.place}}</view><view class="meta">{{item.childName ? item.childName + ' · ' : ''}}{{item.ownerName}}{{item.confirmationLabel ? ' · ' + item.confirmationLabel : ''}}</view><view wx:if="{{item.handoffPending}}" class="hint">等待接任人答复</view></view>
    </view>
  </view>
  <view class="bottom-actions"><button wx:if="{{!shareReady}}" class="ghost" bindtap="prepareShare" loading="{{sharing}}" disabled="{{loading || error || !items.length || sharing}}">分享给家人</button><button wx:else class="ghost" open-type="share" disabled="{{loading || error || !items.length}}">点击转发</button><button class="ghost" bindtap="image" disabled="{{loading || error || !items.length}}">转发图片</button><button class="primary fab" bindtap="add" aria-label="添加事项">＋</button></view>
  <view wx:if="{{detail}}" class="overlay" bindtap="close">
    <view class="sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-top">
        <text class="section">事项详情</text>
        <button class="sheet-close" bindtap="close" aria-label="关闭">×</button>
      </view>
      <view class="detail-title-row"><text class="title">{{detail.title}}</text><text class="badge">{{detail.statusLabel}}</text></view>
      <view class="detail-data">
        <view class="detail-row"><view class="detail-label">时间</view><view>{{detail.date}} · {{detail.timeStart || '当天'}}{{detail.timeEnd ? '—' + detail.timeEnd : ''}}</view></view>
        <view wx:if="{{detail.place}}" class="detail-row"><view class="detail-label">地点</view><view>{{detail.place}}</view></view>
        <view class="detail-row"><view class="detail-label">{{detail.childName ? '孩子 / 负责人' : '负责人'}}</view><view>{{detail.childName ? detail.childName + ' · ' : ''}}{{detail.ownerName}}</view></view>
        <view wx:if="{{detail.note}}" class="detail-row"><view class="detail-label">备注</view><view class="detail-note">{{detail.note}}</view></view>
      </view>
      <view wx:if="{{detail.requiresConfirmation}}" class="confirmation-panel">
        <view><text>负责人确认</text><text class="badge">{{detail.confirmationLabel}}</text></view>
        <view wx:if="{{detail.handoff}}" class="hint">等待{{detail.handoff.targetName}}答复，当前仍由{{detail.ownerName}}负责。</view>
        <button wx:if="{{permissions.confirmOwner}}" class="ghost" data-action="confirmOwner" bindtap="handoffAction" disabled="{{busy}}">确认负责</button>
        <button wx:if="{{permissions.requestHandoff && !detail.handoff && !handoffChoices.length}}" class="ghost" bindtap="selectHandoff" disabled="{{busy}}">发起换人</button>
        <view wx:if="{{handoffChoices.length}}" class="handoff-choices">
          <view class="hint">选择接任成员</view>
          <button wx:for="{{handoffChoices}}" wx:key="_id" class="ghost" data-action="requestHandoff" data-openid="{{item.openid}}" data-name="{{item.name}}" bindtap="handoffAction" disabled="{{busy}}">{{item.name}}</button>
          <button class="text-button" bindtap="cancelHandoffSelection">取消选择</button>
        </view>
        <button wx:if="{{permissions.replyHandoff}}" class="primary" data-action="acceptHandoff" bindtap="handoffAction" disabled="{{busy}}">确认接任</button>
        <button wx:if="{{permissions.replyHandoff}}" class="ghost" data-action="declineHandoff" bindtap="handoffAction" disabled="{{busy}}">无法接任</button>
        <button wx:if="{{permissions.withdrawHandoff}}" class="ghost" data-action="withdrawHandoff" bindtap="handoffAction" disabled="{{busy}}">撤回邀请</button>
      </view>
      <button wx:if="{{permissions.edit}}" class="primary" bindtap="edit">编辑安排</button>
      <block wx:if="{{permissions.status}}">
        <button wx:if="{{detail.status === 'pending' && permissions.complete}}" class="{{permissions.edit ? 'ghost' : 'primary'}}" data-action="setStatus" data-status="done" bindtap="action" disabled="{{busy}}">标记已完成</button>
        <button wx:if="{{detail.status === 'pending'}}" class="ghost" data-action="setStatus" data-status="cancelled" bindtap="action" disabled="{{busy}}">取消安排</button>
        <button wx:else class="ghost" data-action="setStatus" data-status="pending" bindtap="action" disabled="{{busy}}">恢复待处理</button>
      </block>
      <button wx:if="{{permissions.delete}}" class="danger" data-action="delete" bindtap="action" disabled="{{busy}}">删除安排</button>
      <view class="section">变更记录</view>
      <view wx:if="{{events.length}}" class="history-list">
        <view wx:for="{{events}}" wx:key="_id" class="event">
          <view class="event-description">{{item.actorName}} · {{item.label}}{{item.toStatusLabel ? ' · ' + item.toStatusLabel : ''}}{{item.reason ? ' · ' + item.reason : ''}}</view>
          <view class="event-time">{{item.time}}</view>
        </view>
      </view>
      <button wx:if="{{eventCursor}}" class="ghost" bindtap="moreEvents">更多记录</button>
    </view>
  </view>
</view>
