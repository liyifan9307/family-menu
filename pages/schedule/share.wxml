<view class="schedule-page share-page {{images.length ? 'has-poster' : ''}}">
  <view wx:if="{{loading}}" class="state">正在生成完整安排…</view>
  <view wx:elif="{{error}}" class="state">{{error}}<button bindtap="build">重新生成</button></view>
  <block wx:else>
    <scroll-view class="poster-scroll" scroll-y>
      <view class="poster-content">
        <view class="poster-stage">
          <image class="poster-image" src="{{images[activeImage]}}" mode="widthFix" bindtap="preview" aria-label="查看完整分享图片" />
        </view>
        <view wx:if="{{images.length > 1}}" class="poster-pages">
          <button wx:for="{{images}}" wx:key="*this" class="{{index === activeImage ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectImage">第 {{index + 1}} 张</button>
        </view>
      </view>
    </scroll-view>
    <view class="poster-save">
      <view class="hint">保存后可在微信家庭群发送</view>
      <button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">{{saving ? '正在保存…' : images.length === 2 ? '保存两张到相册' : images.length > 2 ? '保存全部到相册' : '保存到相册'}}</button>
    </view>
  </block>
  <canvas canvas-id="poster" style="position:fixed;left:-2000px;top:0;width:{{canvasWidth}}px;height:{{canvasHeight}}px" />
</view>
