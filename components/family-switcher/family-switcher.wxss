.mask { position:fixed; inset:0; z-index:200; background:rgba(16,38,27,.34); display:flex; align-items:flex-end; }
.sheet { width:100%; box-sizing:border-box; padding:24rpx 48rpx calc(48rpx + env(safe-area-inset-bottom)); background:#fff; border-radius:48rpx 48rpx 0 0; color:#263e32; }
.handle { width:64rpx; height:8rpx; background:#eaf0e6; border-radius:8rpx; margin:0 auto 36rpx; }
.heading { display:flex; align-items:center; justify-content:space-between; font-size:38rpx; font-weight:500; margin-bottom:28rpx; }
button { margin:0; font-size:30rpx; line-height:1.5; font-weight:400; } button::after { border:0; }
.sheet button.close { width:80rpx; height:80rpx; padding:0; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#46765a; background:#eaf0e6; }
.choices { max-height:48vh; }
.sheet button.choice { width:100%; margin-left:0; margin-right:0; box-sizing:border-box; display:flex; align-items:center; justify-content:space-between; gap:24rpx; text-align:left; background:#f7f7f2; color:#263e32; padding:28rpx 32rpx; border-radius:28rpx; margin-bottom:20rpx; }
.sheet button.choice.selected { background:#eaf0e6; color:#46765a; }
.info { flex:1; min-width:0; }.name { overflow-wrap:break-word; }.role { font-size:24rpx; color:#657368; margin-top:8rpx; }
.actions { display:flex; gap:20rpx; margin-top:32rpx; }.sheet .actions button { width:auto; min-width:0; flex:1; padding:26rpx 8rpx; color:#46765a; background:#eaf0e6; border-radius:24rpx; }.sheet .actions button.primary { color:white; background:#46765a; }
